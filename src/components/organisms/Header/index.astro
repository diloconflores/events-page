---
import Icon from "../../atoms/Icon/index.astro";
import Button from "../../atoms/Button/index.astro";
import Dropdown from "../../molecules/Dropdown/index.astro";
import { OCCASIONS_URL } from "./constants";
import { getHeaderBrandMenuId, getHeaderPrimaryNavId } from "./logic";
import { getHeaderScript } from "./scripts";
import type { HeaderProps } from "./types";

const { locale, content, common } = Astro.props as HeaderProps;
const brandMenuId = getHeaderBrandMenuId(locale);
const mobileMenuId = getHeaderPrimaryNavId(locale);
const brandMenuItems = [
  {
    id: "events",
    label: content.brand.events,
    href: "#hero",
    selected: true,
  },
  {
    id: "occasions",
    label: content.brand.occasions,
    href: OCCASIONS_URL,
    target: "_blank",
    rel: "nofollow",
    title: content.brand.occasions,
    trailingIcon: "external-link",
  },
] as const;
---

<header
  class="fixed inset-x-0 top-0 z-[100] flex h-[78px] items-center justify-between px-4 text-white transition-[height,color,background-color,border-color,backdrop-filter] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] data-[scrolled=true]:h-[68px] data-[scrolled=true]:border-b data-[scrolled=true]:border-line data-[scrolled=true]:bg-[rgba(251,248,246,0.94)] data-[scrolled=true]:text-ink data-[scrolled=true]:backdrop-blur-[16px] min-[980px]:h-[88px] min-[980px]:px-8"
  data-header
  data-scrolled="false"
>
  <div class="relative z-[2] flex min-w-0 items-center gap-3">
    <a
      class="relative flex min-w-0 items-center gap-2.5"
      href="#hero"
      aria-label={common.homeLabel}
    >
      <img
        class="h-[30px] w-[min(150px,45vw)] object-contain min-[980px]:h-[34px] min-[980px]:w-[150px]"
        src="/brand/logo-horz-white.svg"
        alt={content.brand.label}
        data-brand-logo="white"
      />
      <img
        class="h-[30px] w-[min(150px,45vw)] object-contain min-[980px]:h-[34px] min-[980px]:w-[150px]"
        src="/brand/logo-horz-color.svg"
        alt={content.brand.label}
        hidden
        data-brand-logo="color"
      />
    </a>

    <Dropdown
      id={brandMenuId}
      triggerLabel={content.brand.switcherLabel}
      triggerText={content.brand.division}
      menuLabel={content.brand.switcherLabel}
      items={brandMenuItems}
      class="hidden min-[980px]:flex data-[scrolled=true]:text-ink!"
      triggerClass="data-[scrolled=true]:text-ink!"
    />
  </div>

  <button
    class="group relative z-[2] flex h-[46px] w-[46px] items-center justify-center overflow-hidden rounded-full border border-current/15 bg-[rgba(255,255,255,0.12)] text-current shadow-[0_10px_24px_rgba(0,0,0,0.08)] backdrop-blur-[12px] transition-[background-color,border-color,color,box-shadow] duration-200 min-[980px]:hidden data-[scrolled=true]:border-line data-[scrolled=true]:bg-white/85 data-[scrolled=true]:text-ink data-[open=true]:border-white/15 data-[open=true]:bg-white/15 data-[open=true]:text-white"
    type="button"
    aria-expanded="false"
    aria-controls={mobileMenuId}
    aria-label={common.openMenuLabel}
    data-menu-button
  >
    <Icon
      name="menu"
      class="absolute h-6 w-6 transition-[opacity,transform] duration-200 group-data-[open=true]:scale-90 group-data-[open=true]:opacity-0"
      decorative
    />
    <Icon
      name="x"
      class="absolute h-6 w-6 opacity-0 transition-[opacity,transform] duration-200 group-data-[open=true]:scale-100 group-data-[open=true]:opacity-100"
      decorative
    />
  </button>

  <nav
    id={mobileMenuId}
    class="fixed inset-y-0 right-0 flex w-[min(280px,calc(100vw-24px))] translate-x-full flex-col gap-3 rounded-l-[32px] border-l border-white/10 bg-[rgba(18,12,15,0.96)] px-5 pb-8 pt-[110px] text-white shadow-[-24px_0_40px_rgba(0,0,0,0.18)] backdrop-blur-[18px] transition-transform duration-[350ms] ease-[cubic-bezier(0.4,0,0.2,1)] data-[open=true]:translate-x-0 min-[980px]:static min-[980px]:inset-auto min-[980px]:ml-auto min-[980px]:w-auto min-[980px]:translate-x-0 min-[980px]:flex-row min-[980px]:items-center min-[980px]:gap-6 min-[980px]:border-0 min-[980px]:bg-transparent min-[980px]:px-0 min-[980px]:py-0 min-[980px]:text-inherit"
    data-nav
    data-open="false"
    aria-label={common.primaryNavLabel}
  >
    <Dropdown
      id={`${brandMenuId}-mobile`}
      triggerLabel={content.brand.switcherLabel}
      triggerText={content.brand.division}
      menuLabel={content.brand.switcherLabel}
      items={brandMenuItems}
      class="w-full min-[980px]:hidden"
      triggerClass="w-full justify-between border-white/15 bg-white/5 px-0 py-3 text-[11px] font-semibold tracking-[0.24em] text-white hover:opacity-100"
      menuClass="left-0 right-0 top-[calc(100%+10px)] w-full min-w-0 border-white/10 bg-[rgba(255,255,255,0.08)] shadow-[0_18px_40px_rgba(0,0,0,0.18)]"
      itemClass="text-white hover:bg-white/10 hover:text-white"
      selectedItemClass="bg-white/15 text-white"
    />
    <Button
      href="#service"
      ghost
      class="border-b border-white/10 py-4 text-[18px] font-medium tracking-tight text-white transition-colors hover:text-pink data-[active=true]:text-pink! min-[980px]:border-0 min-[980px]:py-0 min-[980px]:font-sans min-[980px]:text-[12px] min-[980px]:font-semibold min-[980px]:tracking-[0.2em] min-[980px]:text-inherit"
      data-header-nav-link>{content.nav.service}</Button
    >
    <Button
      href="#inspiration"
      ghost
      class="border-b border-white/10 py-4 text-[18px] font-medium tracking-tight text-white transition-colors hover:text-pink data-[active=true]:text-pink! min-[980px]:border-0 min-[980px]:py-0 min-[980px]:font-sans min-[980px]:text-[12px] min-[980px]:font-semibold min-[980px]:tracking-[0.2em] min-[980px]:text-inherit"
      data-header-nav-link>{content.nav.inspiration}</Button
    >
    <Button
      href="#why-us"
      ghost
      class="border-b border-white/10 py-4 text-[18px] font-medium tracking-tight text-white transition-colors hover:text-pink data-[active=true]:text-pink! min-[980px]:border-0 min-[980px]:py-0 min-[980px]:font-sans min-[980px]:text-[12px] min-[980px]:font-semibold min-[980px]:tracking-[0.2em] min-[980px]:text-inherit"
      data-header-nav-link>{content.nav.whyUs}</Button
    >
    <Button
      href="#process"
      ghost
      class="border-b border-white/10 py-4 text-[18px] font-medium tracking-tight text-white transition-colors hover:text-pink data-[active=true]:text-pink! min-[980px]:border-0 min-[980px]:py-0 min-[980px]:font-sans min-[980px]:text-[12px] min-[980px]:font-semibold min-[980px]:tracking-[0.2em] min-[980px]:text-inherit"
      data-header-nav-link>{content.nav.process}</Button
    >
    <Button href="#quote" variant="primary" sharped class="w-full justify-center min-[980px]:w-auto">{content.nav.cta}</Button>
  </nav>
</header>

<script
  type="module"
  set:html={getHeaderScript({
    openMenuLabel: common.openMenuLabel,
    closeMenuLabel: common.closeMenuLabel,
  })}
/>
