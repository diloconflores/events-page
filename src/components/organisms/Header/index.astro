---
import Icon from "../../atoms/Icon/index.astro";
import Button from "../../atoms/Button/index.astro";
import Dropdown from "../../molecules/Dropdown/index.astro";
import { OCCASIONS_URL } from "./constants";
import { getHeaderBrandMenuId, getHeaderPrimaryNavId } from "./logic";
import { getHeaderScript } from "./scripts";
import type { HeaderProps } from "./types";

const { locale, content, common } = Astro.props as HeaderProps;
const brandMenuId = getHeaderBrandMenuId(locale);
const mobileMenuId = getHeaderPrimaryNavId(locale);
const brandMenuItems = [
  {
    id: "events",
    label: content.brand.events,
    href: "#hero",
    selected: true,
    analyticsEvent: "cta_click",
    analyticsName: "events",
    analyticsLocation: "header_brand_switcher",
  },
  {
    id: "occasions",
    label: content.brand.occasions,
    href: OCCASIONS_URL,
    target: "_blank",
    rel: "nofollow",
    title: content.brand.occasions,
    trailingIcon: "external-link",
    analyticsEvent: "cta_click",
    analyticsName: "occasions",
    analyticsLocation: "header_brand_switcher",
  },
] as const;
---

<header
  class="[--header-height:78px] fixed inset-x-0 top-0 z-100 flex h-19.5 items-center justify-between px-4 text-white transition-[height,color,background-color,border-color,backdrop-filter] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] data-[scrolled=true]:h-[68px] data-[scrolled=true]:border-b data-[scrolled=true]:border-line data-[scrolled=true]:bg-[rgba(251,248,246,0.94)] data-[scrolled=true]:text-ink data-[scrolled=true]:backdrop-blur-[16px] min-[980px]:h-[88px] min-[980px]:px-8 min-[980px]:[--header-height:88px]"
  data-header
  data-scrolled="false"
>
  <div class="relative z-2 flex min-w-0 items-center gap-3">
    <a
      class="relative flex min-w-0 items-center gap-2.5"
      href="#hero"
      aria-label={common.homeLabel}
    >
      <img
        class="h-[30px] w-[min(150px,45vw)] object-contain min-[980px]:h-[34px] min-[980px]:w-[150px]"
        src="/brand/logo-horz-white.svg"
        alt={content.brand.label}
        data-brand-logo="white"
      />
      <img
        class="h-[30px] w-[min(150px,45vw)] object-contain min-[980px]:h-[34px] min-[980px]:w-[150px]"
        src="/brand/logo-horz-color.svg"
        alt={content.brand.label}
        hidden
        data-brand-logo="color"
      />
    </a>

    <Dropdown
      id={brandMenuId}
      triggerLabel={content.brand.switcherLabel}
      triggerText={content.brand.division}
      menuLabel={content.brand.switcherLabel}
      items={brandMenuItems}
      class="data-[scrolled=true]:text-ink!"
      triggerClass="data-[scrolled=true]:text-ink!"
      menuClass="max-[979px]:fixed max-[979px]:left-4 max-[979px]:right-4 max-[979px]:top-[calc(var(--header-height,78px)+12px)] max-[979px]:w-auto max-[979px]:min-w-0 max-[979px]:origin-top max-[979px]:rounded-panel max-[979px]:border max-[979px]:border-line max-[979px]:bg-[rgba(255,255,255,0.96)] max-[979px]:shadow-[0_18px_40px_rgba(32,16,22,0.14)] max-[979px]:backdrop-blur-[14px] min-[980px]:!left-0"
    />
  </div>

  <button
    class="group relative z-2 flex h-[46px] w-[46px] items-center justify-center overflow-hidden rounded-full border-0 bg-transparent text-white shadow-none backdrop-blur-0 transition-colors duration-200 min-[980px]:hidden hover:text-brand-pink data-[scrolled=true]:text-ink data-[open=true]:text-ink"
    type="button"
    aria-expanded="false"
    aria-controls={mobileMenuId}
    aria-label={common.openMenuLabel}
    data-menu-button
  >
    <Icon
      name="menu"
      class="absolute h-6 w-6 transition-[opacity,transform] duration-200 group-data-[open=true]:scale-90 group-data-[open=true]:opacity-0"
      decorative
    />
    <Icon
      name="x"
      class="absolute h-6 w-6 opacity-0 transition-[opacity,transform] duration-200 group-data-[open=true]:scale-100 group-data-[open=true]:opacity-100"
      decorative
    />
  </button>

  <nav
    id={mobileMenuId}
    class="fixed right-0 top-[var(--header-height,78px)] z-95 flex h-[calc(100dvh-var(--header-height,78px))] w-[90vw] translate-x-full flex-col gap-3 border-0 bg-transparent px-5 pb-8 pt-6 text-ink shadow-none backdrop-blur-0 opacity-0 transition-[transform,translate,opacity] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] data-[open=true]:translate-x-0 data-[open=true]:opacity-100 data-[closing=true]:translate-x-full data-[closing=true]:opacity-0 max-[979px]:border-l max-[979px]:border-line max-[979px]:bg-[rgba(251,248,246,0.96)] max-[979px]:backdrop-blur-[18px] min-[980px]:static min-[980px]:inset-auto min-[980px]:ml-auto min-[980px]:h-auto min-[980px]:w-auto min-[980px]:translate-x-0 min-[980px]:flex-row min-[980px]:items-center min-[980px]:gap-6 min-[980px]:px-0 min-[980px]:py-0 min-[980px]:text-inherit min-[980px]:opacity-100"
    data-nav
    data-open="false"
    data-closing="false"
    aria-label={common.primaryNavLabel}
  >
    <Button
      href="#service"
      ghost
      class="border-b border-line py-4 text-[18px] font-medium tracking-tight text-ink transition-colors hover:text-pink data-[active=true]:text-pink! min-[980px]:border-0 min-[980px]:py-0 min-[980px]:font-sans min-[980px]:text-[12px] min-[980px]:font-semibold min-[980px]:text-inherit"
      data-analytics-event="cta_click"
      data-analytics-name="service"
      data-analytics-location="header_nav"
      data-header-nav-link>{content.nav.service}</Button
    >
    <Button
      href="#inspiration"
      ghost
      class="border-b border-line py-4 text-[18px] font-medium tracking-tight text-ink transition-colors hover:text-pink data-[active=true]:text-pink! min-[980px]:border-0 min-[980px]:py-0 min-[980px]:font-sans min-[980px]:text-[12px] min-[980px]:font-semibold min-[980px]:text-inherit"
      data-analytics-event="cta_click"
      data-analytics-name="inspiration"
      data-analytics-location="header_nav"
      data-header-nav-link>{content.nav.inspiration}</Button
    >
    <Button
      href="#why-us"
      ghost
      class="border-b border-line py-4 text-[18px] font-medium tracking-tight text-ink transition-colors hover:text-pink data-[active=true]:text-pink! min-[980px]:border-0 min-[980px]:py-0 min-[980px]:font-sans min-[980px]:text-[12px] min-[980px]:font-semibold min-[980px]:text-inherit"
      data-analytics-event="cta_click"
      data-analytics-name="why_us"
      data-analytics-location="header_nav"
      data-header-nav-link>{content.nav.whyUs}</Button
    >
    <Button
      href="#process"
      ghost
      class="border-b border-line py-4 text-[18px] font-medium tracking-tight text-ink transition-colors hover:text-pink data-[active=true]:text-pink! min-[980px]:border-0 min-[980px]:py-0 min-[980px]:font-sans min-[980px]:text-[12px] min-[980px]:font-semibold min-[980px]:text-inherit"
      data-analytics-event="cta_click"
      data-analytics-name="process"
      data-analytics-location="header_nav"
      data-header-nav-link>{content.nav.process}</Button
    >
    <Button
      href="#quote"
      variant="primary"
      sharped
      class="w-full justify-center min-[980px]:w-auto"
      data-analytics-event="cta_click"
      data-analytics-name="quote"
      data-analytics-location="header_nav"
    >
      {content.nav.cta}
    </Button>
  </nav>
</header>

<div
  class="fixed inset-0 z-90 bg-[rgba(0,0,0,0.52)] opacity-0 backdrop-blur-[12px] transition-[opacity,backdrop-filter] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] pointer-events-none data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto data-[closing=true]:opacity-0 min-[980px]:hidden"
  data-header-dropdown-overlay
  data-open="false"
  data-closing="false"
  aria-hidden="true"
></div>

<div
  class="fixed inset-0 z-90 bg-[rgba(0,0,0,0.52)] opacity-0 backdrop-blur-[12px] transition-[opacity,backdrop-filter] duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] pointer-events-none data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto data-[closing=true]:opacity-0 min-[980px]:hidden"
  data-nav-overlay
  data-open="false"
  data-closing="false"
  aria-hidden="true"
>
</div>

<script
  type="module"
  set:html={getHeaderScript({
    openMenuLabel: common.openMenuLabel,
    closeMenuLabel: common.closeMenuLabel,
  })}
/>
