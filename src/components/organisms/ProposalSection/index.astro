---
import ProposalWizard from "../ProposalWizard/index.astro";
import { PROPOSAL_SECTION_ID } from "./constants";
import { cn } from "../../../utils/cn";
import type { ProposalSectionProps } from "./types";

const props = Astro.props as ProposalSectionProps;
const content = props.content;
---

<section id={PROPOSAL_SECTION_ID} class={cn("bg-white py-20 sm:py-24", props.class)}>
  <div class="mx-auto grid w-full max-w-310 gap-8 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
    <div class="max-w-2xl">
      <p class="mb-4 text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink">
        {content.kicker}
      </p>
      <h2 class="font-sans text-3xl font-medium tracking-tight text-brand-ink sm:text-4xl lg:text-5xl">
        {content.title}
      </h2>
      <p class="mt-6 text-base leading-8 text-brand-muted sm:text-lg">
        {content.text}
      </p>

      <div class="mt-8 rounded-4xl border border-brand-line bg-brand-pink-soft p-6">
        <p class="text-sm font-extrabold uppercase tracking-[0.22em] text-brand-pink">
          {content.progress[0]}
        </p>
        <p class="mt-3 text-sm leading-7 text-brand-ink">
          {content.steps[0].copy}
        </p>
      </div>
    </div>

    <ProposalWizard content={content} locale={props.locale} action={props.action} />
  </div>
</section>
