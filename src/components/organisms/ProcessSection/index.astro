---
import type { ProcessSectionProps } from "./types";
import { getProcessSectionScript } from "./scripts";

const props = Astro.props as ProcessSectionProps;
---

<section id="process" class="bg-white py-[72px]" data-process-section>
  <div class="mx-auto w-full max-w-[1240px] px-4 sm:px-6 lg:px-8">
    <div>
      <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-brand-pink">
        {props.content.kicker}
      </p>
      <h2 class="mt-4 font-sans text-[clamp(24px,2.6vw,34px)] font-bold leading-[1.12] tracking-tight text-black">
        {props.content.title}
      </h2>
      <p class="mt-6 text-base leading-8 text-brand-muted">
        {props.content.text}
      </p>
    </div>

    <ol class="relative mt-12 list-none p-0">
      <div class="absolute left-[17px] top-0 bottom-0 w-px bg-[rgba(33,29,31,.14)]"></div>
      {props.content.steps.map((step, index) => (
        <li
          data-process-item
          data-state={index === 0 ? "active" : "inactive"}
          class="group relative origin-top-left pb-20 pl-11 transition-[padding,opacity] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] data-[state=active]:z-10 data-[state=active]:pb-28 data-[state=past]:opacity-85 data-[state=inactive]:opacity-60"
        >
          <span class="absolute left-0 top-0 h-[34px] w-[34px]">
            <span class="absolute inset-0 rounded-full bg-brand-pink/20 opacity-0 group-data-[state=active]:animate-ping group-data-[state=active]:opacity-100"></span>
            <span class="absolute inset-0 grid place-items-center rounded-full border border-[rgba(0,0,0,.12)] bg-[rgba(236,232,231,.95)] text-[10px] font-bold uppercase tracking-[0.18em] text-white transition-[background-color,border-color,color,box-shadow] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-data-[state=active]:border-brand-pink group-data-[state=active]:bg-brand-pink group-data-[state=active]:shadow-[0_0_0_8px_rgba(236,72,153,0.12)] group-data-[state=past]:border-brand-pink/70 group-data-[state=past]:bg-brand-pink/82">
              <span class="h-[7px] w-[7px] rounded-full bg-[rgba(94,89,91,.72)] transition-opacity duration-200 group-data-[state=active]:opacity-0 group-data-[state=past]:opacity-0"></span>
              <span class="absolute inset-0 grid place-items-center opacity-0 transition-opacity duration-200 group-data-[state=active]:opacity-100 group-data-[state=past]:opacity-100">
                {String(index + 1).padStart(2, "0")}
              </span>
            </span>
          </span>

          <div class="origin-top-left transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-data-[state=active]:scale-[1.1] group-data-[state=past]:scale-100 group-data-[state=inactive]:scale-100">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-brand-pink">
              {step.caption}
            </p>
            <h3 class="mt-2 font-sans text-[clamp(24px,2.6vw,34px)] font-bold leading-[1.12] tracking-tight text-black">
              {step.title}
            </h3>
            <p class="mt-3 text-sm font-semibold leading-7 text-brand-ink">
              {step.subtitle}
            </p>
            <p class="mt-3 text-base leading-8 text-brand-muted">
              {step.description}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <script type="module" set:html={getProcessSectionScript()}></script>
</section>
