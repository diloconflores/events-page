---
import Icon from "../../atoms/Icon/index.astro";
import { cn } from "../../../utils/cn";
import {
  getBentoGridColumnClass,
  getBentoGridOverflowCount,
  getBentoGridVisibleItems,
} from "./logic";
import { getBentoGridScript } from "./scripts";
import type { BentoGridProps } from "./types";

const props = Astro.props as BentoGridProps;
const visibleItems = getBentoGridVisibleItems(props.items, props.maxVisibleItems);
const overflowCount = getBentoGridOverflowCount(props.items, props.maxVisibleItems);
const gridClass = getBentoGridColumnClass(props.maxColumns);
const hasOverflow = overflowCount > 0;
const variant = props.variant ?? "album";
---

<div
  data-bento-grid
  data-bento-variant={variant}
  class={cn("relative", props.class)}
  aria-live="polite"
>
  <div class={gridClass}>
    {
      visibleItems.map((item, index) => {
        const isOverflowItem = hasOverflow && index === visibleItems.length - 1;
        const leadTag = item.tags[0];

        return (
          <button
            type="button"
            class="group relative mb-[14px] block w-full break-inside-avoid overflow-hidden rounded-[28px] bg-[#ddd] text-left shadow-[0_18px_42px_rgba(32,16,22,.08)] isolate focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-pink/20"
            data-bento-trigger
            data-bento-index={index}
            data-bento-src={item.src}
            data-bento-thumbnail={item.thumbnail}
            data-bento-width={item.width}
            data-bento-height={item.height}
            data-bento-alt={item.alt}
            data-bento-caption={item.caption}
            data-bento-title={item.title}
            data-bento-subtitle={item.subtitle}
            data-bento-description={item.description}
            data-bento-tags={item.tags.join("|")}
            aria-label={`Abrir ${item.title}`}
          >
            <img
              src={item.thumbnail}
              alt={item.alt}
              width={item.width}
              height={item.height}
              loading="lazy"
              class="block h-auto w-full scale-[1.01] transform-gpu transition-transform duration-[800ms] ease-[cubic-bezier(0.22,0.72,0.2,1)] group-hover:scale-[1.05]"
            />

            <span class="pointer-events-none absolute inset-0 z-10 bg-[linear-gradient(180deg,transparent_25%,rgba(10,7,9,.82))]"></span>

            {
              isOverflowItem ? (
                <span class="absolute inset-0 z-20 grid place-items-center rounded-[inherit] bg-[rgba(6,4,5,.72)] text-[clamp(2rem,4vw,4.2rem)] font-extrabold tracking-[-0.04em] text-white backdrop-blur-[8px]">
                  +{overflowCount}
                </span>
              ) : (
                <span class="absolute inset-x-[18px] bottom-[18px] z-20 grid gap-[3px] text-white">
                  {variant === "album" && leadTag ? (
                    <small class="text-[10px] font-semibold uppercase tracking-[0.18em] text-white/72">
                      {leadTag}
                    </small>
                  ) : null}
                  <strong class="text-[clamp(1rem,1.4vw,1.25rem)] font-bold leading-[1.05] text-white">
                    {item.title}
                  </strong>
                  <em class="text-[12px] not-italic leading-[1.35] text-white/78">
                    {item.subtitle}
                  </em>
                </span>
              )
            }
          </button>
        );
      })
    }
  </div>

  <dialog
    data-bento-modal
    aria-hidden="true"
    data-open="false"
    data-closing="false"
    class="fixed inset-0 z-[120] m-auto grid h-[94vh] w-[96vw] max-w-[1280px] place-items-center border-0 bg-transparent p-0 opacity-0 scale-[0.985] transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] data-[open=true]:opacity-100 data-[open=true]:scale-100 data-[closing=true]:opacity-0 data-[closing=true]:scale-[0.985] [&::backdrop]:bg-[rgba(10,7,9,.94)] [&::backdrop]:backdrop-blur-[7px]"
  >
    <button
      type="button"
      data-bento-close
      class="absolute right-[14px] top-[14px] z-30 flex h-[46px] w-[46px] items-center justify-center rounded-full border border-white/45 bg-[rgba(0,0,0,.25)] text-[28px] leading-none text-white transition hover:bg-[rgba(0,0,0,.35)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
      aria-label="Cerrar"
    >
      ×
    </button>

    <div class="grid w-[min(100%,1360px)] gap-7 grid-cols-1 min-[700px]:grid-cols-[72px_minmax(0,1fr)_72px] min-[700px]:items-center min-[700px]:justify-items-center">
      <button
        type="button"
        data-bento-prev
        class="order-2 flex h-12 w-12 items-center justify-center justify-self-center rounded-full border border-white/18 bg-[rgba(255,255,255,.08)] text-white shadow-[0_12px_28px_rgba(0,0,0,.24)] transition hover:scale-110 hover:bg-[rgba(255,255,255,.16)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20 min-[700px]:order-none min-[700px]:h-[54px] min-[700px]:w-[54px]"
        aria-label="Imagen anterior"
      >
        <Icon name="chevron-left" class="h-5 w-5" decorative />
      </button>

      <div
        data-bento-modal-content
        class="order-1 flex w-full min-w-0 flex-col gap-4 min-[700px]:order-none min-[700px]:flex-row min-[700px]:items-start min-[700px]:gap-[30px]"
      >
        <figure
          data-bento-modal-stage
          class="m-0 inline-grid w-full min-w-0 gap-[14px] self-start min-[700px]:w-fit min-[700px]:flex-none"
        >
          <div
            data-bento-modal-media
            class="relative overflow-hidden rounded-[40px] bg-transparent w-full max-w-full"
          >
            <img
              data-bento-modal-image
              src={props.items[0]?.src}
              alt={props.items[0]?.alt}
              width={props.items[0]?.width}
              height={props.items[0]?.height}
              class="h-auto w-full max-w-full max-h-[min(84vh,900px)] rounded-[40px] object-contain"
            />
            <p
              data-bento-modal-caption
              class="absolute left-[18px] bottom-[18px] z-20 m-0 max-w-[min(70%,420px)] rounded-full bg-[rgba(0,0,0,.5)] px-3 py-2 text-[11px] font-semibold leading-[1.35] text-white backdrop-blur-[10px]"
            >
              {props.items[0]?.caption}
            </p>
            <div
              data-bento-modal-counter
              class="absolute right-[18px] top-[18px] z-20 min-w-[92px] rounded-full bg-[rgba(0,0,0,.5)] px-3 py-2 text-right font-bold tracking-[0.08em] text-white/76 backdrop-blur-[10px]"
            >
              01 / 01
            </div>
          </div>

          <div
            data-bento-modal-dots
            class="flex w-full flex-wrap justify-center gap-2 pt-[2px]"
          >
            {props.items.map((item, index) => (
              <button
                type="button"
                data-bento-dot
                data-bento-index={index}
                aria-label={`Ver imagen ${index + 1}`}
                aria-pressed={index === 0 ? "true" : "false"}
                data-active={index === 0 ? "true" : "false"}
                class="h-[9px] w-[9px] rounded-full border-0 bg-white/28 p-0 transition-[width,background-color,transform] duration-200 data-[active=true]:w-[28px] data-[active=true]:bg-[#e72371]"
              />
            ))}
          </div>
        </figure>

        <figcaption
          data-bento-modal-panel
          class="order-2 grid w-full min-w-0 gap-3 pt-0 text-white min-[700px]:order-none min-[700px]:max-w-[360px] min-[700px]:pt-[10px]"
        >
          <h3
            data-bento-modal-title
            class="m-0 font-sans text-[clamp(1.15rem,2.1vw,1.55rem)] leading-[1.04] text-white"
          >
            {props.items[0]?.title}
          </h3>
          <p
            data-bento-modal-subtitle
            class="m-0 text-[1rem] font-semibold leading-[1.55] text-white/90"
          >
            {props.items[0]?.subtitle}
          </p>
          <p
            data-bento-modal-description
            class="m-0 text-[.95rem] leading-[1.55] text-white/76"
          >
            {props.items[0]?.description}
          </p>
          <a
            class="button button-primary lightbox-cta justify-self-start mt-1"
            href="#quote"
          >
            Quiero una propuesta así
          </a>
        </figcaption>
      </div>

      <button
        type="button"
        data-bento-next
        class="order-3 flex h-12 w-12 items-center justify-center justify-self-center rounded-full border border-white/18 bg-[rgba(255,255,255,.08)] text-white shadow-[0_12px_28px_rgba(0,0,0,.24)] transition hover:scale-110 hover:bg-[rgba(255,255,255,.16)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20 min-[700px]:order-none min-[700px]:h-[54px] min-[700px]:w-[54px]"
        aria-label="Imagen siguiente"
      >
        <Icon name="chevron-right" class="h-5 w-5" decorative />
      </button>
    </div>
  </dialog>

  <script type="module" set:html={getBentoGridScript()}></script>
</div>
