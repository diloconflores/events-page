---
import Icon from "../../atoms/Icon/index.astro";
import { cn } from "../../../utils/cn";
import {
  getBentoGridColumnClass,
  getBentoGridOverflowCount,
  getBentoGridVisibleItems,
} from "./logic";
import { getBentoGridScript } from "./scripts";
import type { BentoGridProps } from "./types";

const props = Astro.props as BentoGridProps;
const visibleItems = getBentoGridVisibleItems(
  props.items,
  props.maxVisibleItems,
);
const overflowCount = getBentoGridOverflowCount(
  props.items,
  props.maxVisibleItems,
);
const gridClass = getBentoGridColumnClass(props.maxColumns);
const hasOverflow = overflowCount > 0;
const variant = props.variant ?? "album";
---

<div
  data-media-grid={variant}
  class={cn("relative", props.class)}
  aria-live="polite"
>
  <div class={gridClass}>
    {
      visibleItems.map((item, index) => {
        const isOverflowItem = hasOverflow && index === visibleItems.length - 1;
        const leadTag = item.tag ?? item.tags[0];

        return (
          <button
            type="button"
            class="media-card group relative mb-[14px] block w-full cursor-pointer break-inside-avoid overflow-hidden rounded-[28px] bg-[#ddd] text-left shadow-[0_18px_42px_rgba(32,16,22,.08)] isolate focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-pink/20"
            data-media-group={variant}
            data-media-index={index}
            data-media-src={item.src}
            data-media-thumbnail={item.thumbnail}
            data-media-width={item.width}
            data-media-height={item.height}
            data-media-alt={item.alt}
            data-media-caption={item.caption}
            data-media-title={item.title}
            data-media-subtitle={item.subtitle}
            data-media-description={item.description ?? item.caption}
            data-media-details={item.details ?? ""}
            data-media-tag={item.tag ?? ""}
            data-media-tags={JSON.stringify(item.tags)}
            aria-label={`Abrir ${item.title}`}
          >
            <img
              src={item.src}
              alt={item.alt}
              width={item.width}
              height={item.height}
              loading="lazy"
              class="block h-auto w-full scale-[1.01] transform-gpu transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.08]"
            />

            <span class="pointer-events-none absolute inset-0 z-10 bg-[linear-gradient(180deg,transparent_25%,rgba(10,7,9,.82))]" />

            {isOverflowItem ? (
              <span class="absolute inset-0 z-20 grid place-items-center rounded-[inherit] bg-[rgba(6,4,5,.72)] text-[clamp(2rem,4vw,4.2rem)] font-extrabold tracking-[-0.04em] text-white backdrop-blur-[8px]">
                +{overflowCount}
              </span>
            ) : (
              <span class="absolute inset-x-[18px] bottom-[18px] z-20 grid gap-[3px] text-white">
                {variant === "album" && leadTag ? (
                  <small class="text-[10px] font-semibold uppercase tracking-[0.18em] text-white/72">
                    {leadTag}
                  </small>
                ) : null}
                <strong class="text-[clamp(1rem,1.4vw,1.25rem)] font-bold leading-[1.05] text-white">
                  {item.title}
                </strong>
                <em class="text-[12px] not-italic leading-[1.35] text-white/78">
                  {item.subtitle}
                </em>
              </span>
            )}
          </button>
        );
      })
    }
  </div>

  <div
    data-lightbox-overlay
    class="fixed inset-0 z-[110] h-[100dvh] w-[100vw] bg-[rgba(10,7,9,.94)] opacity-0 backdrop-blur-[7px] transition-opacity duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] pointer-events-none data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto data-[closing=true]:opacity-0"
    data-open="false"
    data-closing="false"
    data-entered="false"
    aria-hidden="true"
  ></div>

  <dialog
    class={`group lightbox fixed inset-0 z-[120] m-0 hidden h-[100dvh] w-[100vw] max-w-none place-items-center overflow-hidden border-0 bg-transparent p-0
      opacity-0 scale-[0.8] duration-300
      data-[open=true]:grid
      data-[closing=true]:grid
      data-[open=true]:opacity-100
      data-[open=true]:scale-100
      data-[closing=true]:opacity-0
      data-[closing=true]:scale-[0.985]
      data-[open=true]:pointer-events-auto
      data-[closing=true]:pointer-events-auto
      [&::backdrop]:bg-transparent
    `}
    data-lightbox
    aria-hidden="true"
    data-open="false"
    data-closing="false"
    data-entered="false"
  >
    <button
      type="button"
      data-lightbox-close
      class="lightbox-close absolute right-[14px] top-[14px] z-30 flex h-[46px] w-[46px] cursor-pointer items-center justify-center rounded-full border border-white/45 bg-[rgba(0,0,0,.25)] text-[28px] leading-none text-white transition-all duration-200 ease-out hover:scale-105 hover:border-white/60 hover:bg-[rgba(255,255,255,.12)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
      aria-label="Cerrar"
    >
      ×
    </button>

    <div
      class="lightbox-shell relative z-10 grid w-[min(calc(100vw-2rem),1360px)] gap-7 grid-cols-1 opacity-0 transition-opacity duration-200 ease-out group-data-[entered=true]:opacity-100 min-[700px]:grid-cols-[72px_minmax(0,1fr)_72px] min-[700px]:items-center min-[700px]:justify-items-center"
    >
      <button
        type="button"
        data-lightbox-prev
        class="lightbox-nav lightbox-prev order-2 flex h-12 w-12 cursor-pointer items-center justify-center justify-self-center rounded-full border border-white/18 bg-[rgba(255,255,255,.08)] text-white shadow-[0_12px_28px_rgba(0,0,0,.24)] transition-all duration-200 ease-out hover:-translate-x-0.5 hover:scale-105 hover:border-white/30 hover:bg-[rgba(255,255,255,.14)] hover:shadow-[0_16px_34px_rgba(0,0,0,.3)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20 min-[700px]:order-none min-[700px]:h-[54px] min-[700px]:w-[54px]"
        aria-label="Imagen anterior"
      >
        <Icon name="chevron-left" class="h-5 w-5" decorative />
      </button>

      <div
        data-lightbox-content
        class="lightbox-content order-1 grid w-full min-w-0 grid-cols-1 gap-4 opacity-0 transition-opacity duration-200 ease-out group-data-[entered=true]:opacity-100 min-[900px]:order-none min-[900px]:grid-cols-[minmax(0,2fr)_minmax(280px,1fr)] min-[900px]:items-start min-[900px]:gap-[30px]"
      >
        <figure
          data-lightbox-stage
          class="lightbox-stage m-0 grid w-full min-w-0 gap-[14px] self-start opacity-0 transition-opacity duration-200 ease-out group-data-[entered=true]:opacity-100"
        >
          <div
            data-lightbox-media
            class="lightbox-media relative w-full max-w-full overflow-hidden rounded-[40px] bg-transparent opacity-0 transition-opacity duration-200 ease-out group-data-[entered=true]:opacity-100"
          >
            <img
              data-lightbox-image
              src={props.items[0]?.src}
              alt={props.items[0]?.alt}
              width={props.items[0]?.width}
              height={props.items[0]?.height}
              class="h-auto w-full max-w-full max-h-[min(84vh,900px)] rounded-[40px] object-contain"
            />
            <p
              data-lightbox-caption
              class="lightbox-overlay-caption absolute left-[18px] bottom-[18px] z-20 m-0 max-w-[min(70%,420px)] rounded-full bg-[rgba(0,0,0,.5)] px-3 py-2 text-[11px] font-semibold leading-[1.35] text-white backdrop-blur-[10px]"
            >
              {(props.items[0]?.tag ?? props.items[0]?.tags[0] ?? "").toUpperCase()}
            </p>
            <div
              data-lightbox-counter
              class="lightbox-counter lightbox-counter-media absolute right-[18px] top-[18px] z-20 min-w-[92px] rounded-full bg-[rgba(0,0,0,.5)] px-3 py-2 text-right font-bold tracking-[0.08em] text-white/76 backdrop-blur-[10px]"
            >
              01 / 01
            </div>
          </div>

          <div
            data-lightbox-dots
            class="lightbox-dots flex w-full flex-nowrap items-center justify-center gap-2 overflow-x-auto pt-[2px]"
          >
            {
              props.items.map((item, index) => (
                <button
                  type="button"
                  data-lightbox-dot
                  aria-label={`Ver imagen ${index + 1}`}
                  aria-pressed={index === 0 ? "true" : "false"}
                  data-active={index === 0 ? "true" : "false"}
                  class="lightbox-dot h-[9px] w-[9px] shrink-0 rounded-full border-0 bg-white/28 p-0 transition-[width,background-color,transform,opacity] duration-200 data-[active=true]:w-[28px] data-[active=true]:bg-[#e72371]"
                />
              ))
            }
          </div>
        </figure>

        <figcaption
          data-lightbox-panel
          class="lightbox-panel order-2 grid w-full min-w-0 gap-3 pt-0 text-white opacity-0 transition-opacity duration-200 ease-out group-data-[entered=true]:opacity-100 min-[900px]:order-none min-[900px]:self-center min-[900px]:pt-[10px]"
        >
          <h3
            data-lightbox-title
            class="m-0 font-sans text-[clamp(1.15rem,2.1vw,1.55rem)] leading-[1.04] text-white"
          >
            {props.items[0]?.title}
          </h3>
          <p
            data-lightbox-subtitle
            class="m-0 text-[1rem] font-semibold leading-[1.55] text-white/90"
          >
            {props.items[0]?.subtitle}
          </p>
          <p
            data-lightbox-description
            class="m-0 text-[.95rem] leading-[1.55] text-white/76"
          >
            {props.items[0]?.description ?? props.items[0]?.caption}
          </p>
          <ul
            data-lightbox-tags
            class="lightbox-tags m-0 flex list-none flex-wrap gap-2 p-0 pt-1"
            aria-label="Tags descriptivos de la imagen"
          >
            {props.items[0]?.tags.map((tag) => (
              <li class="m-0">
                <span class="inline-flex rounded-full border border-white/15 bg-white/8 px-3 py-1 text-[11px] font-semibold leading-none text-white/90">
                  {tag}
                </span>
              </li>
            ))}
          </ul>
        </figcaption>
      </div>

      <button
        type="button"
        data-lightbox-next
        class="lightbox-nav lightbox-next order-3 flex h-12 w-12 cursor-pointer items-center justify-center justify-self-center rounded-full border border-white/18 bg-[rgba(255,255,255,.08)] text-white shadow-[0_12px_28px_rgba(0,0,0,.24)] transition-all duration-200 ease-out hover:translate-x-0.5 hover:scale-105 hover:border-white/30 hover:bg-[rgba(255,255,255,.14)] hover:shadow-[0_16px_34px_rgba(0,0,0,.3)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20 min-[700px]:order-none min-[700px]:h-[54px] min-[700px]:w-[54px]"
        aria-label="Imagen siguiente"
      >
        <Icon name="chevron-right" class="h-5 w-5" decorative />
      </button>
    </div>
  </dialog>

  <script type="module" set:html={getBentoGridScript()} />
</div>
