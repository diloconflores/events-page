---
import Icon from "../../atoms/Icon/index.astro";
import { cn } from "../../../utils/cn";
import {
  getBentoGridColumnClass,
  getBentoGridOverflowCount,
  getBentoGridVisibleItems,
} from "./logic";
import { getBentoGridScript } from "./scripts";
import type { BentoGridProps } from "./types";

const props = Astro.props as BentoGridProps;
const visibleItems = getBentoGridVisibleItems(props.items, props.maxVisibleItems);
const overflowCount = getBentoGridOverflowCount(props.items, props.maxVisibleItems);
const gridClass = getBentoGridColumnClass(props.maxColumns);
const hasOverflow = overflowCount > 0;
---

<div
  data-bento-grid
  class={cn("relative", props.class)}
  aria-live="polite"
>
  <div class={gridClass}>
    {
      visibleItems.map((item, index) => {
        const isOverflowItem = hasOverflow && index === visibleItems.length - 1;

        return (
          <button
            type="button"
            class="group mb-4 block w-full break-inside-avoid overflow-hidden rounded-[2rem] bg-[#ddd] shadow-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-pink/20"
            data-bento-trigger
            data-bento-index={index}
            data-bento-src={item.src}
            data-bento-thumbnail={item.thumbnail}
            data-bento-width={item.width}
            data-bento-height={item.height}
            data-bento-alt={item.alt}
            data-bento-caption={item.caption}
            data-bento-title={item.title}
            data-bento-subtitle={item.subtitle}
            data-bento-description={item.description}
            data-bento-tags={item.tags.join("|")}
            aria-label={`Abrir ${item.title}`}
          >
            <img
              src={item.thumbnail}
              alt={item.alt}
              width={item.width}
              height={item.height}
              loading="lazy"
              class="block h-auto w-full transition duration-700 group-hover:scale-[1.03]"
            />

            {
              isOverflowItem ? (
                <span class="absolute inset-0 z-20 grid place-items-center bg-[rgba(6,4,5,0.72)] text-[clamp(2rem,4vw,4.2rem)] font-extrabold tracking-[-0.04em] text-white">
                  +{overflowCount}
                </span>
              ) : (
                <span class="absolute inset-x-0 bottom-0 grid gap-[3px] bg-[linear-gradient(180deg,transparent_25%,rgba(10,7,9,.82))] px-4 pb-4 pt-10 text-white">
                  <small class="text-[10px] font-semibold uppercase tracking-[0.18em] text-white/72">
                    {item.caption}
                  </small>
                  <strong class="text-[clamp(1rem,1.2vw,1.2rem)] font-bold leading-[1.05] text-white">
                    {item.title}
                  </strong>
                  <em class="text-[12px] not-italic leading-[1.35] text-white/78">
                    {item.subtitle}
                  </em>
                </span>
              )
            }
          </button>
        );
      })
    }
  </div>

  <div
    data-bento-modal
    aria-hidden="true"
    data-open="false"
    class="fixed inset-0 z-[120] flex items-center justify-center overflow-y-auto bg-[rgba(10,7,9,0.82)] px-4 py-4 opacity-0 backdrop-blur-[16px] transition-[opacity] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] pointer-events-none data-[open=true]:pointer-events-auto data-[open=true]:opacity-100"
  >
    <div
      data-bento-modal-panel
      data-open="false"
      class="relative flex w-full max-w-[min(1400px,calc(100vw-2rem))] flex-col overflow-hidden text-white transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] scale-[0.8] data-[open=true]:scale-100 lg:h-[calc(100dvh-4rem)] lg:flex-row lg:items-stretch lg:overflow-hidden"
    >
      <div class="order-2 flex flex-col gap-6 px-0 pt-6 lg:order-1 lg:h-full lg:w-1/3 lg:pr-8 lg:pt-0">
        <div class="flex-1 overflow-y-auto pr-1">
          <p data-bento-modal-caption class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/72">
            {props.items[0]?.caption}
          </p>
          <h3 data-bento-modal-title class="mt-3 font-sans text-[clamp(2rem,5vw,3.45rem)] leading-[1.04] text-white">
            {props.items[0]?.title}
          </h3>
          <p data-bento-modal-subtitle class="mt-4 text-[12px] font-normal leading-[1.35] text-white/78">
            {props.items[0]?.subtitle}
          </p>
          <p data-bento-modal-description class="mt-6 max-w-xl text-base leading-8 text-white/92">
            {props.items[0]?.description}
          </p>
          <div data-bento-modal-tags class="mt-6 flex flex-wrap gap-2">
            {props.items[0]?.tags.map((tag) => (
              <span class="inline-flex items-center rounded-full border border-white/14 bg-white/10 px-3 py-1 text-[11px] font-semibold tracking-[0.18em] text-white uppercase">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>

      <div class="order-1 flex flex-col gap-4 lg:order-2 lg:h-full lg:w-2/3 lg:min-w-0">
        <div
          data-bento-modal-viewport
          class="relative flex-1 touch-pan-y"
        >
          <img
            data-bento-modal-image
            src={props.items[0]?.src}
            alt={props.items[0]?.alt}
            width={props.items[0]?.width}
            height={props.items[0]?.height}
            class="h-auto max-h-[72vh] w-full rounded-[2rem] object-contain lg:h-full lg:max-h-none"
          />

          <div class="absolute inset-y-0 left-0 right-0 z-20 flex items-center justify-between px-4">
            <button
              type="button"
              data-bento-prev
              class="flex h-[54px] w-[54px] items-center justify-center rounded-full border border-white/18 bg-[rgba(255,255,255,0.08)] text-white transition hover:scale-110 hover:bg-[rgba(255,255,255,0.16)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20"
              aria-label="Anterior"
            >
              <Icon name="chevron-left" class="h-5 w-5" decorative />
            </button>

            <div
              data-bento-modal-counter
              class="rounded-full border border-white/18 bg-[rgba(255,255,255,0.08)] px-3 py-2 text-[11px] font-semibold tracking-[0.22em] text-white backdrop-blur-[16px]"
            >
              01 / 01
            </div>

            <button
              type="button"
              data-bento-next
              class="flex h-[54px] w-[54px] items-center justify-center rounded-full border border-white/18 bg-[rgba(255,255,255,0.08)] text-white transition hover:scale-110 hover:bg-[rgba(255,255,255,0.16)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20"
              aria-label="Siguiente"
            >
              <Icon name="chevron-right" class="h-5 w-5" decorative />
            </button>
          </div>

          <button
            type="button"
            data-bento-close
            class="absolute right-4 top-4 z-30 flex h-[54px] w-[54px] items-center justify-center rounded-full border border-white/18 bg-[rgba(255,255,255,0.08)] text-white transition hover:scale-110 hover:bg-[rgba(255,255,255,0.16)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20"
            aria-label="Cerrar"
          >
            <Icon name="x" class="h-5 w-5" decorative />
          </button>

          <div
            data-bento-modal-counter
            class="absolute bottom-4 right-4 z-20 rounded-full border border-white/18 bg-[rgba(255,255,255,0.08)] px-3 py-2 text-[11px] font-semibold tracking-[0.22em] text-white backdrop-blur-[16px]"
          >
            01 / 01
          </div>

          <div class="mt-4 flex items-center justify-center gap-2">
            {props.items.map((item, index) => (
              <button
                type="button"
                data-bento-dot
                data-bento-index={index}
                aria-label={`Ir al elemento ${index + 1}`}
                aria-pressed={index === 0 ? "true" : "false"}
                data-active={index === 0 ? "true" : "false"}
                class="h-[9px] w-[9px] rounded-full bg-white/28 transition-[width,background-color,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] data-[active=true]:w-[28px] data-[active=true]:rounded-full data-[active=true]:bg-[#e72371]"
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="module" set:html={getBentoGridScript()}></script>
</div>
