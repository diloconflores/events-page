---
import AllianceCard from "../../molecules/AllianceCard/index.astro";
import { ALLIANCES_SECTION_ID } from "./constants";
import type { AlliancesSectionProps } from "./types";

const { content } = Astro.props as AlliancesSectionProps;
---

<section id={ALLIANCES_SECTION_ID} class="bg-linear-to-b from-white to-brand-pink-soft py-[88px] min-[700px]:py-[120px]">
  <div class="mx-auto w-full max-w-[1240px] px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(320px,420px)] lg:items-center">
      <div class="max-w-[830px]">
        <p class="mb-4 text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink">
          {content.kicker}
        </p>
        <h2 class="font-sans text-3xl font-medium tracking-tight text-brand-ink sm:text-4xl lg:text-5xl">
          {content.title}
        </h2>
        <p class="mt-4 max-w-[760px] text-base leading-8 text-brand-muted sm:text-lg">
          {content.text}
        </p>
      </div>

      <div class="grid gap-[18px] justify-items-end lg:justify-self-end">
        {content.items.map((item) => (
          <AllianceCard
            href={item.href}
            label={item.label}
            copy={item.copy}
            logo={item.logo}
            class="w-full max-w-[420px]"
            target="_blank"
            rel="nofollow noopener noreferrer"
            data-analytics-event="cta_click"
            data-analytics-name="bodas_com_mx"
            data-analytics-location="alliances"
          />
        ))}
      </div>
    </div>
  </div>
</section>
