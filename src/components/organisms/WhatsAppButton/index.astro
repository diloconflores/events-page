---
import Button from "../../atoms/Button/index.astro";
import { cn } from "../../../utils/cn";
import { WHATSAPP_URL } from "./constants";
import type { WhatsAppButtonProps } from "./types";

const props = Astro.props as WhatsAppButtonProps;
const href = props.href ?? WHATSAPP_URL;
const ariaLabel = props.ariaLabel ?? props.label;
---

<Button
  href={href}
  target={props.target ?? "_blank"}
  rel={props.rel ?? "noopener noreferrer"}
  variant="ghost"
  rounded
  class={cn(
    "fixed bottom-4 right-4 z-[90] max-w-[min(calc(100vw-2rem),22rem)] items-start gap-3 bg-[#25D366] px-5 py-4 text-left text-white shadow-[0_18px_40px_rgba(37,211,102,0.35)] transition hover:-translate-y-1 hover:bg-[#1fb95b] focus-visible:ring-2 focus-visible:ring-[#25D366]/35 sm:max-w-[22.5rem]",
    props.class,
  )}
  aria-label={ariaLabel}
  data-analytics-event="whatsapp_click"
  data-analytics-name={props.analyticsName ?? "floating_whatsapp"}
  data-analytics-location={props.analyticsLocation ?? "floating_button"}
>
  <span class="grid gap-0.5 leading-tight">
    <span class="grid h-6 w-6 place-items-center rounded-full bg-white/14" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-current" role="img" aria-hidden="true" focusable="false">
        <path d="M12.04 2C6.495 2 2 6.478 2 11.999a9.93 9.93 0 0 0 1.45 5.164L2 22l5.02-1.4A10 10 0 0 0 12.04 22C17.585 22 22 17.521 22 12S17.585 2 12.04 2Zm5.866 14.52c-.24.67-1.43 1.25-1.98 1.34-.513.086-1.165.12-1.876-.115-.433-.143-.985-.332-1.713-.651-3.03-1.331-5.01-4.428-5.165-4.64-.153-.213-1.23-1.696-1.23-3.235 0-1.538.805-2.295 1.088-2.61.283-.314.619-.393.838-.393.22 0 .442.002.635.01.203.01.478-.072.745.54.268.615.912 2.13.994 2.284.081.154.134.334.028.537-.106.203-.16.33-.32.512-.16.183-.337.408-.509.577-.184.184-.375.385-.162.75.214.365.946 1.556 2.028 2.527 1.396 1.255 2.57 1.647 2.934 1.83.364.183.576.154.788-.092.213-.246.91-1.073 1.156-1.442.245-.368.49-.306.828-.183.337.123 2.147 1.014 2.518 1.2.372.184.619.275.707.429.088.153.088.892-.212 1.461Z" />
      </svg>
    </span>
    <span class="text-[11px] font-semibold tracking-[0.18em] text-white/82 uppercase">
      {props.prompt}
    </span>
    <span class="text-[14px] font-extrabold tracking-tight text-white sm:text-[15px]">
      {props.label}
    </span>
  </span>
</Button>
