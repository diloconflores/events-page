---
import BentoGrid from "../BentoGrid/index.astro";
import type { InspirationSectionProps } from "./types";

const props = Astro.props as InspirationSectionProps;
const items = props.content.album.map((item) => ({
  src: item.src,
  thumbnail: item.thumbnail ?? item.src,
  width: item.width ?? 1280,
  height: item.height ?? 1600,
  alt: item.alt,
  caption: item.caption,
  title: item.title,
  subtitle: item.subtitle,
  description: item.caption,
  tags: item.tag ? [item.tag] : [],
}));
---

<section id="inspiration" class="bg-brand-cream py-20 sm:py-24">
  <div class="mx-auto w-full max-w-[1240px] px-4 sm:px-6 lg:px-8">
    <div class="max-w-[830px]">
      <p class="mb-4 text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink">
        {props.content.kicker}
      </p>
      <h2 class="font-sans text-3xl font-medium tracking-tight text-brand-ink sm:text-4xl lg:text-5xl">
        {props.content.title}
      </h2>
      <p class="mt-6 max-w-2xl text-base leading-8 text-brand-muted sm:text-lg">
        {props.content.text}
      </p>
    </div>

    <BentoGrid
      items={items}
      maxColumns={3}
      variant="album"
      maxVisibleItems={items.length}
      class="mt-10"
    />
  </div>
</section>
