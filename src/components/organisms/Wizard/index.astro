---
import Button from "../../atoms/Button/index.astro";
import Checkbox from "../../atoms/Checkbox/index.astro";
import Icon from "../../atoms/Icon/index.astro";
import Input from "../../atoms/Input/index.astro";
import Radio from "../../atoms/Radio/index.astro";
import Select from "../../atoms/Select/index.astro";
import Textarea from "../../atoms/Textarea/index.astro";
import { cn } from "../../../utils/cn";
import {
  getWizardFieldsForStep,
  getWizardFieldId,
  getWizardSteps,
} from "./logic";
import { getWizardScript } from "./scripts";
import type { WizardProps } from "./types";

const props = Astro.props as WizardProps;
const schema = props.schema;
const steps = getWizardSteps(schema);
---

<div
  data-wizard-root
  class={cn(
    "form-card rounded-[40px] border border-[rgba(232,223,227,.9)] bg-[linear-gradient(180deg,#fff,rgba(255,255,255,.96))] p-10 shadow-[0_24px_60px_rgba(34,16,24,.08)]",
    props.class,
  )}
>
  <form
    id={schema.formId}
    action={props.action}
    method="POST"
    novalidate
    class="grid gap-6"
    data-wizard-form
    data-analytics-form={schema.analytics.formName}
    data-analytics-location={schema.analytics.location}
    data-locale={props.locale}
    data-submit-label={schema.controls.submit}
    data-loading-label={schema.controls.loading}
  >
    {
      schema.hiddenFields?.map((field) => (
        <input type="hidden" name={field.name} value={field.value} />
      ))
    }
    <input
      type="text"
      name="_gotcha"
      tabindex="-1"
      autocomplete="off"
      class="sr-only"
    />

    <div class="grid gap-5 pt-[2px] pb-[2px]">
      <div class="flex items-start justify-between gap-4">
        <p
          class="text-[12px] font-bold tracking-[0.08em] text-brand-pink"
          aria-live="polite"
          data-wizard-active-tab-title
        >
          {schema.progress[0]}
        </p>
        <p class="text-right text-[11px] font-semibold text-brand-muted">
          Te tomará aproximadamente 2 minutos
        </p>
      </div>
      <div
        class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4"
        data-wizard-phase-track
      >
        {
          schema.progress.map((_, phaseIndex) => (
            <div
              class="grid gap-2"
              data-wizard-phase-timeline
              data-wizard-phase-index={phaseIndex}
            >
              <div
                class="h-[6px] overflow-hidden rounded-full bg-[#efe6ea]"
                aria-hidden="true"
              >
                <span
                  data-wizard-phase-fill
                  class="block h-full w-0 rounded-full bg-[linear-gradient(90deg,#e72371,#ff7ba9)] transition-[width] duration-300 ease-[cubic-bezier(.22,.72,.2,1)]"
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="grid gap-6">
      {
        steps.map((step, stepIndex) => {
          const isLastStep = stepIndex === steps.length - 1;

          return (
            <fieldset
              class="grid gap-4"
              data-wizard-step
              data-wizard-step-legend={step.legend}
              data-wizard-tab-title={step.tabTitle}
              data-wizard-phase-index={step.phaseIndex}
              hidden={stepIndex !== 0}
            >
              <legend class="text-[clamp(1.02rem,1.8vw,1.5rem)] font-bold leading-[1.1] text-brand-ink">
                {step.legend}
              </legend>
              {step.copy ? (
                <p class="max-w-[68ch] text-[0.93rem] leading-7 text-brand-muted">
                  {step.copy}
                </p>
              ) : null}

              <div
                class={
                  isLastStep
                    ? "grid gap-4 sm:grid-cols-2 mt-5"
                    : "grid gap-4 mt-5"
                }
              >
                {getWizardFieldsForStep(schema, step.order).map((field) => {
                  const fieldId = getWizardFieldId(schema, field);
                  const validation = field.validation
                    ? JSON.stringify(field.validation)
                    : undefined;
                  const conditions = field.showWhen
                    ? JSON.stringify(field.showWhen)
                    : undefined;
                  const isContactHalfWidth =
                    isLastStep &&
                    (field.name === "contactPhone" ||
                      field.name === "contactEmail");
                  const isFullWidth = isLastStep && !isContactHalfWidth;
                  const wrapperCommon = {
                    "data-wizard-field": true,
                    "data-wizard-field-id": fieldId,
                    "data-wizard-field-kind": field.kind,
                    "data-wizard-field-required": field.required
                      ? "true"
                      : "false",
                    "data-wizard-field-validation": validation,
                    "data-wizard-show-when": conditions,
                  } as const;

                  if (field.kind === "input") {
                    return (
                      <div
                        {...wrapperCommon}
                        class={
                          isContactHalfWidth
                            ? "sm:col-span-1"
                            : isFullWidth
                              ? "sm:col-span-2"
                              : undefined
                        }
                      >
                        <Input
                          id={fieldId}
                          name={field.name}
                          label={field.label}
                          helperText={field.helperText}
                          errorText={field.errorText}
                          invalid={false}
                          required={field.required}
                          placeholder={field.placeholder}
                          autocomplete={field.autocomplete}
                          type={field.type ?? "text"}
                          min={
                            field.type === "date"
                              ? field.validation?.min
                              : undefined
                          }
                          max={
                            field.type === "date"
                              ? field.validation?.max
                              : undefined
                          }
                          class="w-full"
                        />
                      </div>
                    );
                  }

                  if (field.kind === "textarea") {
                    return (
                      <div
                        {...wrapperCommon}
                        class={isFullWidth ? "sm:col-span-2" : undefined}
                      >
                        <Textarea
                          id={fieldId}
                          name={field.name}
                          label={field.label}
                          helperText={field.helperText}
                          errorText={field.errorText}
                          invalid={false}
                          required={field.required}
                          placeholder={field.placeholder}
                          autocomplete={field.autocomplete}
                          rows={field.rows ?? 5}
                          class="w-full"
                        />
                      </div>
                    );
                  }

                  if (field.kind === "select") {
                    return (
                      <div
                        {...wrapperCommon}
                        class={isFullWidth ? "sm:col-span-2" : undefined}
                      >
                        <Select
                          id={fieldId}
                          name={field.name}
                          label={field.label}
                          helperText={field.helperText}
                          errorText={field.errorText}
                          invalid={false}
                          required={field.required}
                          autocomplete={field.autocomplete}
                          class="w-full"
                        >
                          <option value="">
                            {field.placeholder ?? field.label}
                          </option>
                          {field.options.map((option) => (
                            <option value={option.value}>{option.label}</option>
                          ))}
                        </Select>
                      </div>
                    );
                  }

                  if (field.kind === "radio-group") {
                    return (
                      <div
                        {...wrapperCommon}
                        class={cn("grid gap-3", isFullWidth && "sm:col-span-2")}
                      >
                        <p class="text-sm font-semibold text-brand-ink">
                          {field.label}
                          {field.required ? <span class="ml-1 text-[#e45b63]">*</span> : null}
                        </p>
                        <div class="grid gap-2">
                          {field.options.map((option) => (
                            <Radio
                              name={field.name}
                              value={option.value}
                              label={option.label}
                              helperText={option.helperText}
                              required={field.required}
                            />
                          ))}
                        </div>
                        {field.helperText ? (
                          <p class="text-[11px] leading-5 text-brand-muted">
                            {field.helperText}
                          </p>
                        ) : null}
                        {field.errorText ? (
                          <p
                            data-wizard-group-error
                            hidden
                            class="text-[11px] font-medium leading-5 text-[#b42318]"
                          >
                            {field.errorText}
                          </p>
                        ) : null}
                      </div>
                    );
                  }

                  if (field.kind === "checkbox-group") {
                    return (
                      <div
                        {...wrapperCommon}
                        class={cn("grid gap-3", isFullWidth && "sm:col-span-2")}
                      >
                        <p class="text-sm font-semibold text-brand-ink">
                          {field.label}
                          {field.required ? <span class="ml-1 text-[#e45b63]">*</span> : null}
                        </p>
                        <div class="grid gap-2 sm:grid-cols-2">
                          {field.options.map((option) => (
                            <Checkbox
                              name={`${field.name}[]`}
                              value={option.value}
                              label={option.label}
                              helperText={option.helperText}
                              required={field.required}
                            />
                          ))}
                        </div>
                        {field.helperText ? (
                          <p class="text-[11px] leading-5 text-brand-muted">
                            {field.helperText}
                          </p>
                        ) : null}
                        {field.errorText ? (
                          <p
                            data-wizard-group-error
                            hidden
                            class="text-[11px] font-medium leading-5 text-[#b42318]"
                          >
                            {field.errorText}
                          </p>
                        ) : null}
                      </div>
                    );
                  }

                  if (field.kind === "text") {
                    return (
                      <div
                        {...wrapperCommon}
                        class={cn(
                          "flex items-start gap-2 text-[#4a4a4a]",
                          isFullWidth && "sm:col-span-2",
                        )}
                      >
                        <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center text-[#4a4a4a]">
                          <Icon
                            name={field.icon ?? "lock"}
                            decorative
                            class="h-4 w-4"
                          />
                        </span>
                        <p class="text-sm leading-7 text-[#4a4a4a]">
                          {field.text}
                        </p>
                      </div>
                    );
                  }

                  return (
                    <div
                      {...wrapperCommon}
                      class={isFullWidth ? "sm:col-span-2" : undefined}
                    >
                      <Checkbox
                        id={fieldId}
                        name={field.name}
                        value={field.value ?? "Sí"}
                        label={field.label}
                        helperText={field.helperText}
                        errorText={field.errorText}
                        invalid={false}
                        required={field.required}
                      />
                    </div>
                  );
                })}
              </div>
              {isLastStep ? (
                <div class="flex flex-wrap items-center justify-end gap-3 pt-2">
                  <button
                    type="submit"
                    class="submit-button min-h-[58px] min-w-[240px] items-center justify-between gap-3 rounded-[18px] bg-pink px-5 py-4 text-sm font-bold text-white shadow-glow transition hover:bg-pink-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pink/30"
                    data-wizard-submit
                    hidden
                  >
                    <span data-wizard-submit-label>
                      {schema.controls.submit}
                    </span>
                    <span
                      data-wizard-submit-icon
                      class="grid h-5 w-5 place-items-center transition-opacity duration-200"
                    >
                      <Icon name="send" decorative class="h-4 w-4" />
                    </span>
                    <span
                      data-wizard-submit-spinner
                      class="hidden h-5 w-5 rounded-full border-2 border-white/35 border-t-white animate-spin"
                      aria-hidden="true"
                    />
                  </button>
                </div>
              ) : null}
            </fieldset>
          );
        })
      }
    </div>

    <div class="flex items-center gap-3 pt-2">
      <div class="flex items-center gap-3">
        <Button
          type="button"
          variant="wizard-back"
          leadingIcon="arrow-left"
          data-wizard-back
          hidden
          class="group-hover:gap-3 transition-[gap] duration-200"
        >
          {schema.controls.previous}
        </Button>
      </div>
      <div class="ml-auto flex items-center gap-3">
        <Button
          type="button"
          variant="wizard-next"
          trailingIcon="arrow-right"
          data-wizard-next
          class="group-hover:gap-3 transition-[gap] duration-200"
        >
          {schema.controls.next}
        </Button>
      </div>
    </div>

    <div
      class="hidden rounded-[40px] border border-[#f5b7ae] bg-[#fff4f2] p-8 text-center text-[#8e2418]"
      role="alert"
      data-wizard-form-error
    >
      <strong class="block text-base font-semibold text-brand-ink">
        {schema.messages.errorTitle}
      </strong>
      <p class="mt-3 text-sm leading-7 text-brand-muted">
        {schema.messages.errorBody}
      </p>
    </div>
  </form>

  <div
    class="grid gap-5 rounded-4xl border border-brand-line bg-brand-surface p-8 text-center shadow-soft opacity-0 transition-opacity duration-300 ease-out"
    data-wizard-success
    hidden
  >
    <div
      class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-brand-pink-soft text-brand-pink shadow-[0_12px_30px_rgba(231,35,113,.12)]"
    >
      <Icon name="check" decorative class="h-8 w-8" />
    </div>
    <p
      class="text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink"
    >
      {schema.messages.successKicker}
    </p>
    <h3 class="mt-4 text-2xl font-semibold tracking-tight text-brand-ink">
      {schema.messages.successTitle}
    </h3>
    <p class="mt-4 text-sm leading-7 text-brand-muted">
      {schema.messages.successText}
    </p>
    <Button
      type="button"
      variant="primary"
      data-wizard-new-request
      class="mt-6"
    >
      {schema.messages.successButton}
    </Button>
  </div>

  <script type="module" set:html={getWizardScript()} />
</div>
