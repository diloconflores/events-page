---
import Button from "../../../../atoms/Button/index.astro";
import type { LandingPageContent } from "../../../../../i18n/types";

interface ServiceAreaSectionProps {
  readonly content: NonNullable<LandingPageContent["serviceArea"]>;
}

const { content } = Astro.props as ServiceAreaSectionProps;
const highlightedAreas = content.areas.slice(0, 4);
const remainingAreas = content.areas.slice(4);
---

<section class="bg-linear-to-b from-white to-brand-pink-soft py-[88px] min-[700px]:py-[120px]">
  <div class="mx-auto w-full max-w-[1240px] px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(320px,440px)] lg:items-center">
      <div class="max-w-[830px]">
        <p class="mb-4 text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink">
          {content.kicker}
        </p>
        <h2 class="max-w-3xl font-sans text-3xl font-medium tracking-tight text-brand-ink sm:text-4xl lg:text-5xl">
          {content.title}
        </h2>
        <p class="mt-6 max-w-[760px] text-base leading-8 text-brand-muted sm:text-lg">
          {content.text}
        </p>

        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          <div class="rounded-4xl border border-brand-line bg-white p-5 shadow-[0_12px_28px_rgba(34,16,24,0.06)]">
            <p class="text-[0.65rem] font-extrabold uppercase tracking-[0.28em] text-brand-pink">
              Cobertura
            </p>
            <p class="mt-3 text-sm leading-7 text-brand-ink">
              Servicio en Nuevo León con atención localizada para cada tipo de evento.
            </p>
          </div>
          <div class="rounded-4xl border border-brand-line bg-white p-5 shadow-[0_12px_28px_rgba(34,16,24,0.06)]">
            <p class="text-[0.65rem] font-extrabold uppercase tracking-[0.28em] text-brand-pink">
              Atención
            </p>
            <p class="mt-3 text-sm leading-7 text-brand-ink">
              Te guiamos desde la cotización hasta el montaje para que todo se vea profesional.
            </p>
          </div>
          <div class="rounded-4xl border border-brand-line bg-white p-5 shadow-[0_12px_28px_rgba(34,16,24,0.06)]">
            <p class="text-[0.65rem] font-extrabold uppercase tracking-[0.28em] text-brand-pink">
              Enfoque SEO
            </p>
            <p class="mt-3 text-sm leading-7 text-brand-ink">
              Cada landing está pensada para búsquedas locales y para convertir visitas en leads.
            </p>
          </div>
        </div>
      </div>

      <aside class="rounded-4xl border border-brand-line bg-white p-6 shadow-soft sm:p-8">
        <p class="text-[0.7rem] font-extrabold uppercase tracking-[0.28em] text-brand-pink">
          {content.areasLabel}
        </p>
        <h3 class="mt-3 font-sans text-2xl font-medium tracking-tight text-brand-ink">
          Presencia en los municipios clave de Nuevo León
        </h3>
        <p class="mt-4 text-sm leading-7 text-brand-muted">
          Nos enfocamos en cobertura real en el área metropolitana y municipios cercanos para que la promesa comercial se sienta concreta, no genérica.
        </p>

        <ul class="mt-6 flex flex-wrap gap-2">
          {highlightedAreas.map((area) => (
            <li class="rounded-full border border-brand-line bg-brand-pink-soft px-4 py-2 text-sm font-semibold text-brand-ink">
              {area}
            </li>
          ))}
        </ul>

        {remainingAreas.length > 0 ? (
          <div class="mt-4 rounded-3xl bg-brand-cream p-4">
            <p class="text-[0.62rem] font-extrabold uppercase tracking-[0.26em] text-brand-pink">
              Más cobertura
            </p>
            <p class="mt-2 text-sm leading-7 text-brand-ink">
              {remainingAreas.join(" · ")}
            </p>
          </div>
        ) : null}

        <Button
          href="#quote"
          variant="primary"
          trailingIcon="arrow-right"
          class="mt-6 w-fit"
          data-analytics-event="cta_click"
          data-analytics-name="service_area_quote"
          data-analytics-location="service_area"
        >
          Cotizar en mi municipio
        </Button>
      </aside>
    </div>
  </div>
</section>
