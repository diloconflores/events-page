---
import Button from "../../../../atoms/Button/index.astro";
import ShopProductCard from "../../../../molecules/ShopProductCard/index.astro";

interface ShopSectionProps {
  readonly content: {
    readonly kicker: string;
    readonly title: string;
    readonly text: string;
    readonly products: readonly {
      readonly url: string;
      readonly image: string;
      readonly alt: string;
      readonly label: string;
      readonly title: string;
    }[];
    readonly footerText: string;
    readonly footerButton: string;
  };
  readonly url: string;
}

const { content, url } = Astro.props as ShopSectionProps;
---

<section id="shop" class="bg-white py-20 sm:py-24">
  <div class="mx-auto w-full max-w-310 px-4 sm:px-6 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-[1fr_0.9fr] lg:items-end">
      <div>
        <p class="mb-4 text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink">
          {content.kicker}
        </p>
        <h2 class="max-w-3xl font-sans text-3xl font-medium tracking-tight text-brand-ink sm:text-4xl lg:text-5xl">
          {content.title}
        </h2>
      </div>
      <p class="max-w-2xl text-base leading-8 text-brand-muted sm:text-lg">
        {content.text}
      </p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {content.products.map((product) => (
        <ShopProductCard
          href={product.url}
          target="_blank"
          rel="noopener noreferrer"
          image={product.image}
          alt={product.alt}
          label={product.label}
          title={product.title}
          data-analytics-event="cta_click"
          data-analytics-name={product.title}
          data-analytics-location="shop_products"
        />
      ))}
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-4 rounded-4xl border border-brand-line bg-brand-pink-soft p-6 sm:flex-row sm:items-center">
      <p class="max-w-2xl text-sm leading-7 text-brand-ink">
        {content.footerText}
      </p>
      <Button
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        trailingIcon="arrow-right"
        data-analytics-event="cta_click"
        data-analytics-name="shop_footer"
        data-analytics-location="shop"
      >
        {content.footerButton}
      </Button>
    </div>
  </div>
</section>
