---
import Button from "../../atoms/Button/index.astro";
import Icon from "../../atoms/Icon/index.astro";
import MediaCard from "../../atoms/MediaCard/index.astro";
import CompleteService from "../../organisms/CompleteService/index.astro";
import InspirationSection from "../../organisms/InspirationSection/index.astro";
import Hero from "../../organisms/Hero/index.astro";
import Header from "../../organisms/Header/index.astro";
import WhatsAppButton from "../../organisms/WhatsAppButton/index.astro";
import ShopProductCard from "../../molecules/ShopProductCard/index.astro";
import { getEventLandingScript } from "./scripts";
import type { EventLandingProps } from "./types";
import { EVENT_FORM_ACTION, OCCASIONS_URL, SHOP_URL } from "./constants";
import { getGalleryOverflowCount, getVisibleGalleryItems } from "./logic";

const { locale, content, common } = Astro.props as EventLandingProps;
const visibleGalleryItems = getVisibleGalleryItems(content);
const galleryOverflowCount = getGalleryOverflowCount(content);
---

<a
  href="#content"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-brand-ink focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
>
  {common.skipLink}
</a>

<Header locale={locale} content={content} common={common} />

<main id="content">
  <Hero content={content.hero} />

  <CompleteService content={{ promise: content.promise, conversionBand: content.conversionBand }} />
  <InspirationSection content={content.inspiration} />

  <section id="why-us" class="relative isolate overflow-hidden bg-brand-ink text-white">
    <img
      src="/why-dilo-flores.webp"
      alt={content.whyUs.imageAlt}
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(14,10,12,0.12)_0%,rgba(14,10,12,0.4)_18%,rgba(14,10,12,0.88)_60%,rgba(14,10,12,0.98)_100%)]"></div>

    <div class="relative mx-auto grid w-full max-w-[1240px] gap-8 px-4 py-20 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-stretch lg:px-8 lg:py-24">
      <div></div>
      <div class="rounded-[2.25rem] border border-white/12 bg-white/6 p-8 shadow-soft backdrop-blur-sm sm:p-10 lg:p-12">
        <p class="mb-4 text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink-soft/90">
          {content.whyUs.kicker}
        </p>
        <h2 class="max-w-3xl font-sans text-3xl font-medium tracking-tight text-white sm:text-4xl lg:text-5xl">
          {content.whyUs.title}
        </h2>
        <p class="mt-6 max-w-2xl text-base leading-8 text-white/82 sm:text-lg">
          {content.whyUs.text}
        </p>

        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {content.whyUs.bullets.map((bullet) => (
            <li class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/6 p-4 text-sm leading-7 text-white/90">
              <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-pink-soft" />
              <span>{bullet}</span>
            </li>
          ))}
        </ul>

        <Button
          href="#quote"
          variant="light"
          trailingIcon="arrow-right"
          class="mt-8 border-0"
          data-analytics-event="cta_click"
          data-analytics-name="why_us_quote"
          data-analytics-location="why_us"
        >
          {content.whyUs.cta}
        </Button>
      </div>
    </div>
  </section>

  <section id="process" class="bg-white py-20 sm:py-24">
    <div class="mx-auto w-full max-w-[1240px] px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[1fr_0.9fr] lg:items-end">
        <div>
          <p class="mb-4 text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink">
            {content.process.kicker}
          </p>
          <h2 class="max-w-3xl font-sans text-3xl font-medium tracking-tight text-brand-ink sm:text-4xl lg:text-5xl">
            {content.process.title}
          </h2>
        </div>
        <p class="max-w-2xl text-base leading-8 text-brand-muted sm:text-lg">
          {content.process.text}
        </p>
      </div>

      <ol class="mt-12 grid gap-4">
        {content.process.steps.map((step) => (
          <li class="grid gap-4 rounded-[2rem] border border-brand-line bg-brand-surface p-6 shadow-soft lg:grid-cols-[auto_1fr] lg:gap-8 lg:p-7">
            <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-brand-pink-soft text-sm font-extrabold tracking-[0.22em] text-brand-pink">
              {step.number}
            </span>
            <div>
              <h3 class="text-xl font-semibold tracking-tight text-brand-ink">
                {step.title}
              </h3>
              <p class="mt-3 max-w-4xl text-sm leading-7 text-brand-muted">
                {step.description}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="alliances" class="bg-brand-pink-soft py-20 sm:py-24">
    <div class="mx-auto w-full max-w-[1240px] px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[1fr_0.9fr] lg:items-end">
        <div>
          <p class="mb-4 text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink">
            {content.alliances.kicker}
          </p>
          <h2 class="max-w-3xl font-sans text-3xl font-medium tracking-tight text-brand-ink sm:text-4xl lg:text-5xl">
            {content.alliances.title}
          </h2>
        </div>
        <p class="max-w-2xl text-base leading-8 text-brand-muted sm:text-lg">
          {content.alliances.text}
        </p>
      </div>

      <div class="mt-10 grid gap-4">
        <a
          href={OCCASIONS_URL}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="group rounded-[2rem] border border-brand-line bg-white p-7 shadow-soft transition hover:-translate-y-1 hover:shadow-glow"
          data-analytics-event="cta_click"
          data-analytics-name="bodas_com_mx"
          data-analytics-location="alliances"
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="text-[0.68rem] font-extrabold uppercase tracking-[0.28em] text-brand-pink">
                {content.alliances.label}
              </p>
              <h3 class="mt-3 text-2xl font-semibold tracking-tight text-brand-ink">
                {content.alliances.copy}
              </h3>
            </div>
            <Icon name="star" class="h-6 w-6 text-brand-pink transition group-hover:scale-110" />
          </div>
        </a>
      </div>
    </div>
  </section>

  <section id="gallery" class="bg-brand-cream py-20 sm:py-24">
    <div class="mx-auto w-full max-w-[1240px] px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[1fr_0.9fr] lg:items-end">
        <div>
          <p class="mb-4 text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink">
            {content.gallery.kicker}
          </p>
          <h2 class="max-w-4xl font-sans text-3xl font-medium tracking-tight text-brand-ink sm:text-4xl lg:text-5xl">
            {content.gallery.title}
          </h2>
        </div>
        <p class="max-w-2xl text-base leading-8 text-brand-muted sm:text-lg">
          {content.gallery.text}
        </p>
      </div>

      <div class="mt-10 columns-1 gap-4 space-y-4 sm:columns-2 xl:columns-3">
        {visibleGalleryItems.map((item, index) => (
          <MediaCard
            href={item.src}
            target="_blank"
            rel="noopener noreferrer"
            variant="gallery"
            src={item.src}
            thumbnail={item.thumbnail}
            width={item.width}
            height={item.height}
            alt={item.alt}
            title={item.title}
            subtitle={item.subtitle}
            ariaLabel={`Abrir ${item.title}`}
            overflowCount={index === visibleGalleryItems.length - 1 ? galleryOverflowCount : undefined}
            data-analytics-event="cta_click"
            data-analytics-name={item.title}
            data-analytics-location="gallery"
          />
        ))}
      </div>
    </div>
  </section>

  <section id="quote" class="bg-white py-20 sm:py-24">
    <div class="mx-auto grid w-full max-w-[1240px] gap-8 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
      <div class="max-w-2xl">
        <p class="mb-4 text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink">
          {content.form.kicker}
        </p>
        <h2 class="font-sans text-3xl font-medium tracking-tight text-brand-ink sm:text-4xl lg:text-5xl">
          {content.form.title}
        </h2>
        <p class="mt-6 text-base leading-8 text-brand-muted sm:text-lg">
          {content.form.text}
        </p>

        <div class="mt-8 rounded-[2rem] border border-brand-line bg-brand-pink-soft p-6">
          <p class="text-sm font-extrabold uppercase tracking-[0.22em] text-brand-pink">
            {content.form.progress[0]}
          </p>
          <p class="mt-3 text-sm leading-7 text-brand-ink">
            {content.form.steps[0].copy}
          </p>
        </div>
      </div>

      <form
        id="event-form"
        action={EVENT_FORM_ACTION}
        method="POST"
        class="form-card rounded-[2rem] border border-brand-line bg-brand-surface p-6 shadow-soft sm:p-8"
        data-analytics-form="event_quote"
        data-analytics-location="quote"
      >
        <input type="hidden" name="_subject" value={`${content.brand.label} — ${content.nav.cta}`} />
        <input type="hidden" name="_language" value={locale} />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="sr-only" />

        <div class="grid gap-6">
          <fieldset class="grid gap-4">
            <legend class="text-sm font-extrabold uppercase tracking-[0.22em] text-brand-pink">
              {content.form.steps[0].legend}
            </legend>
            <p class="text-sm leading-7 text-brand-muted">{content.form.steps[0].copy}</p>
            <label class="grid gap-2">
              <span class="text-sm font-semibold text-brand-ink">{content.form.labels.eventType}</span>
              <select name="eventType" required class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none ring-0 transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10">
                <option value="">{content.form.messages.typeEvent}</option>
                {content.form.options.eventTypes.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </label>
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-2">
                <span class="text-sm font-semibold text-brand-ink">{content.form.labels.eventDate}</span>
                <input type="date" name="eventDate" required class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10" />
              </label>
              <label class="grid gap-2">
                <span class="text-sm font-semibold text-brand-ink">{content.form.labels.guestCount}</span>
                <select name="guestCount" required class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10">
                  <option value="">{content.form.messages.guestCount}</option>
                  {content.form.options.guestCounts.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              </label>
            </div>
            <label class="grid gap-2">
              <span class="text-sm font-semibold text-brand-ink">{content.form.labels.municipality}</span>
              <select name="municipality" required class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10">
                <option value="">{content.form.messages.municipality}</option>
                {content.form.options.municipalities.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </label>
          </fieldset>

          <fieldset class="grid gap-4">
            <legend class="text-sm font-extrabold uppercase tracking-[0.22em] text-brand-pink">
              {content.form.steps[1].legend}
            </legend>
            <p class="text-sm leading-7 text-brand-muted">{content.form.steps[1].copy}</p>
            <label class="grid gap-2">
              <span class="text-sm font-semibold text-brand-ink">{content.form.labels.spaces}</span>
              <div class="grid gap-2 sm:grid-cols-2">
                {content.form.options.spaces.map((option) => (
                  <label class="flex items-center gap-3 rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink">
                    <input type="checkbox" name="spaces" value={option.value} class="h-4 w-4 rounded border-brand-line text-brand-pink focus:ring-brand-pink" />
                    <span>{option.label}</span>
                  </label>
                ))}
              </div>
            </label>
            <label class="grid gap-2">
              <span class="text-sm font-semibold text-brand-ink">{content.form.labels.style}</span>
              <select name="style" required class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10">
                <option value="">{content.form.messages.style}</option>
                {content.form.options.styles.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </label>
            <label class="grid gap-2">
              <span class="text-sm font-semibold text-brand-ink">{content.form.labels.colors}</span>
              <textarea name="colors" rows="3" class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10" placeholder={content.form.placeholders.colors}></textarea>
            </label>
          </fieldset>

          <fieldset class="grid gap-4">
            <legend class="text-sm font-extrabold uppercase tracking-[0.22em] text-brand-pink">
              {content.form.steps[2].legend}
            </legend>
            <p class="text-sm leading-7 text-brand-muted">{content.form.steps[2].copy}</p>
            <label class="grid gap-2">
              <span class="text-sm font-semibold text-brand-ink">{content.form.labels.venue}</span>
              <select name="venue" required class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10">
                <option value="">{content.form.messages.venue}</option>
                {content.form.options.yesNoVenue.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </label>
            <label class="grid gap-2">
              <span class="text-sm font-semibold text-brand-ink">{content.form.labels.venueName}</span>
              <input type="text" name="venueName" placeholder={content.form.placeholders.venueName} class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10" />
            </label>
          </fieldset>

          <fieldset class="grid gap-4">
            <legend class="text-sm font-extrabold uppercase tracking-[0.22em] text-brand-pink">
              {content.form.steps[9].legend}
            </legend>
            <p class="text-sm leading-7 text-brand-muted">{content.form.steps[9].copy}</p>
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-2">
                <span class="text-sm font-semibold text-brand-ink">{content.form.labels.contactName}</span>
                <input type="text" name="contactName" required placeholder={content.form.placeholders.contactName} class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10" />
              </label>
              <label class="grid gap-2">
                <span class="text-sm font-semibold text-brand-ink">{content.form.labels.contactPhone}</span>
                <input type="tel" name="contactPhone" required placeholder={content.form.placeholders.contactPhone} class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10" />
              </label>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-2">
                <span class="text-sm font-semibold text-brand-ink">{content.form.labels.contactEmail}</span>
                <input type="email" name="contactEmail" required placeholder={content.form.placeholders.contactEmail} class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10" />
              </label>
              <label class="grid gap-2">
                <span class="text-sm font-semibold text-brand-ink">{content.form.labels.preferredContact}</span>
                <select name="preferredContact" required class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10">
                  <option value="">{content.form.messages.preferredContact}</option>
                  {content.form.options.preferredContacts.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              </label>
            </div>
            <label class="grid gap-2">
              <span class="text-sm font-semibold text-brand-ink">{content.form.labels.additionalInfo}</span>
              <textarea name="additionalInfo" rows="4" placeholder={content.form.placeholders.additionalInfo} class="rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm text-brand-ink outline-none transition focus:border-brand-pink focus:ring-4 focus:ring-brand-pink/10"></textarea>
            </label>
            <label class="flex items-start gap-3 rounded-2xl border border-brand-line bg-white px-4 py-3 text-sm leading-6 text-brand-muted">
              <input type="checkbox" name="privacy" required class="mt-1 h-4 w-4 rounded border-brand-line text-brand-pink focus:ring-brand-pink" />
              <span>{content.form.labels.privacy}</span>
            </label>
            <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
              <Button type="button" variant="wizard-back" leadingIcon="arrow-left" data-wizard-back>
                {content.form.messages.previous}
              </Button>
              <Button type="button" variant="wizard-next" trailingIcon="arrow-right" data-wizard-next>
                {content.form.messages.next}
              </Button>
              <button
                type="submit"
                class="hidden items-center justify-between gap-3 rounded-[18px] bg-brand-pink px-5 py-4 text-sm font-bold text-white shadow-glow transition hover:bg-brand-pink-dark"
                data-submit
                disabled
              >
                <span class="submit-label">{content.form.messages.submit}</span>
                <Icon name="send" class="submit-arrow h-4 w-4" />
                <span class="spinner hidden h-5 w-5 animate-spin rounded-full border-2 border-white/30 border-t-white" aria-hidden="true"></span>
              </button>
            </div>
            <div class="hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-900" role="alert" data-form-error>
              <strong>{content.form.messages.errorTitle}</strong>
              <p class="mt-1">{content.form.messages.errorBody}</p>
            </div>
          </fieldset>
        </div>
        <div class="hidden rounded-[2rem] border border-brand-line bg-brand-surface p-8 text-center shadow-soft" data-success>
          <p class="text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink">
            {content.form.messages.successKicker}
          </p>
          <h3 class="mt-4 text-2xl font-semibold tracking-tight text-brand-ink">
            {content.form.messages.successTitle}
          </h3>
          <p class="mt-4 text-sm leading-7 text-brand-muted">
            {content.form.messages.successText}
          </p>
          <Button type="button" variant="primary" data-new-request class="mt-6">
            {content.form.messages.successButton}
          </Button>
        </div>
      </form>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-brand-pink py-20 text-white sm:py-24">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.18),transparent_35%),radial-gradient(circle_at_bottom_right,rgba(255,255,255,0.1),transparent_30%)]"></div>
    <div class="relative mx-auto grid w-full max-w-[1240px] gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_auto] lg:items-center lg:px-8">
      <div class="max-w-4xl">
        <p class="mb-4 text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink-soft/90">
          {content.finalCta.kicker}
        </p>
        <h2 class="font-sans text-3xl font-medium tracking-tight text-white sm:text-4xl lg:text-6xl">
          {content.finalCta.title}
        </h2>
      </div>
      <Button
        href="#quote"
        variant="light"
        trailingIcon="arrow-right"
        class="border-0"
        data-analytics-event="cta_click"
        data-analytics-name="final_quote"
        data-analytics-location="final_cta"
      >
        {content.finalCta.cta}
      </Button>
    </div>
  </section>

  <section id="shop" class="bg-white py-20 sm:py-24">
    <div class="mx-auto w-full max-w-[1240px] px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[1fr_0.9fr] lg:items-end">
        <div>
          <p class="mb-4 text-[0.7rem] font-extrabold uppercase tracking-[0.34em] text-brand-pink">
            {content.shop.kicker}
          </p>
          <h2 class="max-w-3xl font-sans text-3xl font-medium tracking-tight text-brand-ink sm:text-4xl lg:text-5xl">
            {content.shop.title}
          </h2>
        </div>
        <p class="max-w-2xl text-base leading-8 text-brand-muted sm:text-lg">
          {content.shop.text}
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {content.shop.products.map((product) => (
          <ShopProductCard
            href={product.url}
            target="_blank"
            rel="noopener noreferrer"
            image={product.image}
            alt={product.alt}
            label={product.label}
            title={product.title}
            data-analytics-event="cta_click"
            data-analytics-name={product.title}
            data-analytics-location="shop_products"
          />
        ))}
      </div>

      <div class="mt-10 flex flex-col items-start justify-between gap-4 rounded-[2rem] border border-brand-line bg-brand-pink-soft p-6 sm:flex-row sm:items-center">
        <p class="max-w-2xl text-sm leading-7 text-brand-ink">
          {content.shop.footerText}
        </p>
        <Button
          href={SHOP_URL}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
          trailingIcon="arrow-right"
          data-analytics-event="cta_click"
          data-analytics-name="shop_footer"
          data-analytics-location="shop"
        >
          {content.shop.footerButton}
        </Button>
      </div>
    </div>
  </section>
</main>

<WhatsAppButton
  prompt={common.whatsappPrompt}
  label={common.whatsappLabel}
  analyticsName="floating_whatsapp"
