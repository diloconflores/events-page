---
import { cn } from "../../../utils/cn";
import type { AllianceCardProps } from "./types";

const {
  class: className,
  copy,
  href,
  label,
  logo,
  target,
  rel,
  title,
  ...attributes
} = Astro.props as AllianceCardProps;
---

<a
  href={href}
  class={cn(
    "group grid gap-4 rounded-[24px] border border-[rgba(231,35,113,.12)] bg-[linear-gradient(180deg,rgba(255,255,255,.94),rgba(255,247,250,.88))] p-[22px] text-left shadow-[0_18px_40px_rgba(32,16,22,.06)] backdrop-blur-[12px] transition-[translate,scale,opacity,box-shadow,border-color] duration-300 ease-[cubic-bezier(0.22,0.72,0.2,1)] hover:-translate-y-2 hover:scale-[1.01] hover:border-[rgba(231,35,113,.24)] hover:opacity-[.98] hover:shadow-[0_18px_34px_rgba(32,16,22,.08)] motion-reduce:transition-none",
    className,
  )}
  title={title ?? label}
  aria-label={attributes["aria-label"] ?? label}
  target={target}
  rel={rel}
  {...attributes}
>
  <div class="flex items-center justify-between gap-3.5">
    <span class="text-[12px] font-extrabold uppercase tracking-[0.16em] text-brand-pink">
      {label}
    </span>
    <span class="inline-flex items-center justify-end p-0" aria-hidden="true">
      <img
        src={logo.src}
        alt={logo.alt}
        width={logo.width}
        height={logo.height}
        class="max-h-[48px] w-auto max-w-[180px] object-contain"
      />
    </span>
  </div>

  <p class="m-0 max-w-[46ch] text-[1.02rem] leading-[1.55] text-brand-muted">
    {copy}
  </p>
</a>
