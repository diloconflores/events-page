---
import Button from "../../atoms/Button/index.astro";
import Icon from "../../atoms/Icon/index.astro";
import { cn } from "../../../utils/cn";
import { getDropdownScript } from "./scripts";
import type { DropdownProps } from "./types";

const props = Astro.props as DropdownProps;
---

<div
  class={cn("group relative flex items-center", props.class)}
  data-dropdown
  data-open="false"
>
  <Button
    type="button"
    variant="ghost"
    sharped
    trailingIcon="chevron-down"
    trailingIconClass="h-4 w-4 shrink-0 transition-transform duration-200 group-data-[open=true]:rotate-180"
    class={cn(
      "inline-flex items-center gap-1.5 border-0 border-l border-current bg-transparent px-0 pl-2.5 font-sans text-[10px] font-bold uppercase leading-none tracking-[0.2em] text-current transition-opacity hover:opacity-[0.82]",
      props.triggerClass,
    )}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls={props.id}
    aria-label={props.triggerText}
    data-dropdown-trigger
    data-open="false"
  >
    {props.triggerText}
  </Button>

  <div
    id={props.id}
    class={cn(
      "absolute left-0 top-[calc(100%+10px)] z-120 grid min-w-55 origin-top-left gap-1 overflow-hidden rounded-xl border border-[rgba(232,223,227,0.9)] bg-[rgba(255,255,255,0.96)] shadow-[0_18px_40px_rgba(32,16,22,0.14)] backdrop-blur-[14px] opacity-0 -translate-y-4 scale-[0.98] pointer-events-none transition-all duration-250 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-[opacity,transform] data-[open=true]:pointer-events-auto data-[open=true]:translate-y-0 data-[open=true]:scale-100 data-[open=true]:opacity-100",
      props.menuClass,
    )}
    role="menu"
    aria-label={props.menuLabel}
    hidden
    aria-hidden="true"
    data-open="false"
    data-dropdown-menu
  >
    {
      props.items.map((item) => (
        <a
          class={cn(
            "flex items-center justify-between rounded-xl px-3 py-2.5 text-[12px] font-bold transition-colors",
            item.selected
              ? "bg-pink-soft text-pink"
              : "text-ink hover:bg-pink-soft hover:text-pink",
            props.itemClass,
            item.selected && props.selectedItemClass,
          )}
          href={item.href}
          target={item.target}
          rel={item.rel}
          title={item.title}
          role="menuitem"
          aria-current={item.selected ? "page" : undefined}
          data-dropdown-item={item.id}
          data-analytics-event={item.analyticsEvent}
          data-analytics-name={item.analyticsName}
          data-analytics-location={item.analyticsLocation}
        >
          <span>{item.label}</span>
          {item.trailingIcon ? (
            <Icon
              name={item.trailingIcon}
              decorative
              class={item.trailingIconClass ?? "h-4 w-4 shrink-0"}
            />
          ) : null}
        </a>
      ))
    }
  </div>
</div>

<script type="module" set:html={getDropdownScript()} />
