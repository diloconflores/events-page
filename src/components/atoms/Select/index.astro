---
import Icon from "../Icon/index.astro";
import { cn } from "../../../utils/cn";
import { getSelectDescribedBy, getSelectId } from "./logic";
import type { SelectProps } from "./types";

const {
  class: className = "",
  selectClass: selectClassName = "",
  labelClass: labelClassName = "",
  helperClass: helperClassName = "",
  errorClass: errorClassName = "",
  invalid = false,
  label,
  helperText,
  errorText,
  leadingIcon,
  trailingIcon: trailingIconProp,
  id: providedId,
  ...attributes
} = Astro.props as SelectProps;
const id = getSelectId({ id: providedId, name: attributes.name });
const describedBy = getSelectDescribedBy(id, helperText, errorText, invalid);
const trailingIcon = trailingIconProp ?? "chevron-down";
const hasLeadingIcon = leadingIcon !== undefined;
const hasTrailingIcon = trailingIcon !== undefined;
---

<div class={cn("grid gap-2", className)}>
  {
    label ? (
      <label class={cn("text-sm font-semibold text-brand-ink", labelClassName)} for={id}>
        {label}
      </label>
    ) : null
  }

  <div class="relative">
    {
      leadingIcon ? (
        <span class="pointer-events-none absolute inset-y-0 left-[14px] grid place-items-center text-brand-muted">
          <Icon name={leadingIcon} decorative class="h-4 w-4" />
        </span>
      ) : null
    }

    <select
      id={id}
      aria-invalid={invalid ? "true" : undefined}
      aria-describedby={describedBy}
      class={cn(
        "w-full appearance-none rounded-[18px] border border-brand-line bg-white px-[14px] py-[13px] text-sm text-brand-ink outline-none transition-[border-color,box-shadow] duration-200 focus:border-brand-pink focus:ring-[3px] focus:ring-[rgba(231,35,113,.09)] disabled:cursor-not-allowed disabled:bg-brand-surface disabled:text-brand-muted",
        hasLeadingIcon && "pl-11",
        hasTrailingIcon && "pr-11",
        invalid && "border-[#e45b63] focus:border-[#e45b63] focus:ring-[3px] focus:ring-[rgba(228,91,99,.12)]",
        selectClassName,
      )}
      {...attributes}
    >
      <slot />
    </select>

    {
      trailingIcon ? (
        <span class="pointer-events-none absolute inset-y-0 right-[14px] grid place-items-center text-brand-muted">
          <Icon name={trailingIcon} decorative class="h-4 w-4" />
        </span>
      ) : null
    }
  </div>

  {helperText ? (
    <p id={`${id}-helper`} class={cn("text-[11px] leading-5 text-brand-muted", helperClassName)}>
      {helperText}
    </p>
  ) : null}

  {errorText ? (
    <p id={`${id}-error`} hidden={!invalid} class={cn("text-[11px] font-medium leading-5 text-[#b42318]", errorClassName)}>
      {errorText}
    </p>
  ) : null}
</div>
