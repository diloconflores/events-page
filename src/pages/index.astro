---
import BaseLayout from "../layouts/BaseLayout/index.astro";
import EventLanding from "../components/templates/EventLanding/index.astro";
import { defaultLocale, getCommonTranslations, getLandingContent, getLocalizedPath } from "../i18n";

const locale = defaultLocale;
const common = getCommonTranslations(locale);
const content = getLandingContent(locale);
const canonicalPath = getLocalizedPath(locale);
---

<BaseLayout locale={locale} title={content.metadata.title} description={content.metadata.description} canonicalPath={canonicalPath} route="home">
  <EventLanding locale={locale} content={content} common={common} />
</BaseLayout>
