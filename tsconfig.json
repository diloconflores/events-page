{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"ignoreDeprecations": "5.0",
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*", ".astro/types.d.ts"],
	"exclude": ["dist"]
}
